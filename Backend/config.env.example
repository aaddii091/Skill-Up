PORT=3000
DATABASE=mongodb://127.0.0.1:27017/skill-up
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=90d
CLIENT_ORIGIN=http://localhost:5173

# Optional: when unset, Skill Up serves a playable fallback quiz.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional X.509 certificate authentication for MongoDB Atlas. When set, use
# authMechanism=MONGODB-X509&authSource=%24external in DATABASE.
MONGODB_X509_CERT=
